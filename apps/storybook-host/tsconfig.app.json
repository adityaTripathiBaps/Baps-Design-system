{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": [],
    "emitDeclarationOnly": false,
    "lib": ["es2022", "dom"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/test-setup.ts",
    "**/*.stories.ts",
    "**/*.stories.js"
  ],
  "references": [
    {
      "path": "../../libs/tokens/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ui-kit/tsconfig.lib.json"
    }
  ]
}
